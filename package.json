{
	"name": "owlbrain-core",
	"version": "0.2.1",
	"documentation": "docs/",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "tsup",
		"test": "vitest",
		"test:watch": "vitest --watch",
		"example": "tsx scripts/run-example.ts",
		"lint": "eslint \"src/**/*.{ts,tsx}\""
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/armaell/owlbrain-core.git"
	},
	"homepage": "https://github.com/armaell/owlbrain-core#readme",
	"keywords": [
		"owlbrain",
		"typescript"
	],
	"files": [
		"dist",
		"docs"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./integration": {
			"types": "./dist/integration.d.ts",
			"default": "./dist/integration.js"
		},
		"./test": {
			"types": "./dist/test.d.ts",
			"default": "./dist/test.js"
		}
	},
	"devDependencies": {
		"@types/later": "^1.2.9",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"prettier": "^3.9.6",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@datastructures-js/linked-list": "^6.1.4",
		"@list-abstraction/doubly-linked-list": "^9.0.1",
		"colorette": "^2.0.20",
		"fast-glob": "^3.3.3",
		"later": "^1.2.0",
		"vite-tsconfig-paths": "^6.1.1"
	}
}
